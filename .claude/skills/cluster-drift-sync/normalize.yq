del(.status, .metadata.managedFields, .metadata.uid, .metadata.resourceVersion, .metadata.creationTimestamp, .metadata.generation, .metadata.annotations["deployment.kubernetes.io/revision"], .metadata.annotations["kubectl.kubernetes.io/last-applied-configuration"], .metadata.annotations["meta.helm.sh/release-name"], .metadata.annotations["meta.helm.sh/release-namespace"], .metadata.labels["app.kubernetes.io/managed-by"], .spec.template.metadata.annotations["kubectl.kubernetes.io/restartedAt"], .spec.template.metadata.annotations["deployment-timestamp"])
| (.. | select(tag == "!!seq" and length > 0 and (.[0] | tag == "!!map") and (.[0] | has("name")))) |= sort_by(.name)
| del(.. | select(tag == "!!null"))
| del(.. | select(tag == "!!map" and length == 0))
| .. style="" | .. comments=""
| sort_keys(..)
